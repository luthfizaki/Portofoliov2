{
  "name": "luthfi-portfolio-v2",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "db:create": "node server/create-database.js",
    "dev": "concurrently -n web,api -c blue,green \"vite --host 0.0.0.0 --port 3100\" \"node server/index.js\"",
    "dev:web": "vite --host 0.0.0.0 --port 3100",
    "dev:api": "node server/index.js",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js",
    "dev:cms": "pnpm --filter @portfoliov2/cms-admin dev",
    "dev:api:v1": "pnpm --filter @portfoliov2/backend-api start:dev",
    "build:cms": "pnpm --filter @portfoliov2/cms-admin build",
    "build:api:v1": "pnpm --filter @portfoliov2/backend-api build",
    "db:generate": "pnpm --filter @portfoliov2/backend-api prisma:generate",
    "db:migrate": "pnpm --filter @portfoliov2/backend-api prisma:migrate",
    "db:seed": "pnpm --filter @portfoliov2/backend-api prisma:seed",
    "db:import-legacy": "pnpm --filter @portfoliov2/backend-api exec tsx scripts/import-legacy-json.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lenis": "^1.3.25",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
